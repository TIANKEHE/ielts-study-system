{
  "name": "kyes",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "WATCHPACK_POLLING=true next dev --webpack --hostname 127.0.0.1",
    "build": "node scripts/generate-clients.mjs && next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "db:push": "prisma db push",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate": "node scripts/generate-clients.mjs",
    "postinstall": "node scripts/generate-clients.mjs",
    "build:vercel": "node scripts/check-cloud-env.mjs && node scripts/generate-clients.mjs && next build --webpack",
    "db:deploy:postgres": "prisma migrate deploy --schema prisma/postgresql/schema.prisma",
    "migration:export": "node scripts/migration/export.mjs",
    "migration:plan": "node scripts/migration/import.mjs",
    "test:postgres": "vitest run tests/postgres.test.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@prisma/client": "6.19.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "0.468.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.65.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-socket": "^0.2.13",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "prisma": "6.19.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "packageManager": "pnpm@11.25.0"
}
