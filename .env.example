DATABASE_URL="file:./learning.db"

# Local SQLite remains the default. Cloud values below are placeholders only.
KYES_AUTH_MODE=local
# For PostgreSQL/Vercel change DATABASE_URL to the transaction-pooler URL:
# DATABASE_URL="postgresql://USER:ENCODED_PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=20&schema=kyes&sslmode=require"
# DIRECT_URL="postgresql://ADMIN:ENCODED_PASSWORD@HOST:5432/postgres?schema=kyes&sslmode=require"
# KYES_AUTH_MODE=supabase
# SUPABASE_URL="https://PROJECT_REF.supabase.co"
# SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_KEY"
# SUPABASE_ALLOWED_USER_ID="YOUR_AUTH_USER_UUID"
# APP_URL="https://YOUR_DOMAIN"
# Migration CLI only; do not place this admin credential in browser/public variables.
# MIGRATION_DATABASE_URL="postgresql://ADMIN:ENCODED_PASSWORD@HOST:5432/postgres?schema=kyes&sslmode=require"
# Local PostgreSQL backup CLI only (use Session mode, never a public variable):
# BACKUP_DATABASE_URL="postgresql://APP_USER:ENCODED_PASSWORD@HOST:5432/postgres?schema=kyes&sslmode=require"
